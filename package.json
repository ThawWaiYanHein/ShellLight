{
  "name": "shelllight",
  "version": "1.1.2",
  "private": true,
  "license": "MIT",
  "description": "Your environments. One click away.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && node scripts/launch.cjs",
    "smoke": "node scripts/launch.cjs --smoke-test",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "dev.shelllight.app",
    "productName": "ShellLight",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release/shelllight-1.1.2"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  }
}
